#
# Copy this file to `.env` (which is gitignored) and paste your real key.
# The key lives ONLY on the server. NEVER put it in the browser or the repo.

# Your Anthropic API key. Get one at https://console.anthropic.com/
# Replace the placeholder below with your real key (it starts with sk-ant-...).
ANTHROPIC_API_KEY=sk-ant-<PASTE_YOUR_KEY_HERE>

# Port the proxy listens on (optional; default 8787).
PORT=8787

# Allowed CORS origin for the browser app (optional; default * for local demo).
# In production, set this to your site's exact origin, e.g. https://example.com
ALLOWED_ORIGIN=*

# --- 고도화: cost-efficient real AI (all optional) ---------------------------
# Cost-first default model. Raise to claude-sonnet-5 or claude-opus-5 for higher
# quality (and higher cost). Haiku 4.5 does NOT use adaptive thinking/effort.
AI_MODEL=claude-haiku-4-5

# Effort for non-Haiku models only (ignored for Haiku). low | medium | high
AI_EFFORT=low

# Per-IP rate limit (requests per minute). Default 20.
AI_RATE_LIMIT=20

# Monthly token budget. When exceeded the proxy returns 429 {fallback:true} and
# the browser silently uses its offline mock. Default 2000000 (2M tokens/month).
AI_MONTHLY_TOKEN_CAP=2000000
